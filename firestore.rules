rules_version = '2';

// Reglas de seguridad de PokéSurvivor.
//   saves/{uid}            partida: sólo su dueño
//   names/{apodo}          reserva de apodos únicos (en minúsculas)
//   profiles/{uid}         apodo público de cada jugador
//   friendships/{a_b}      solicitudes y amistades entre dos jugadores
//   runs/{uid}             cuándo empezó tu última partida (anti-trampas del ranking)
//   lb/{tabla}/e/{id}      ranking de tiempo aguantado
//   reports/{tabla__id__uid}  reportes de marcas sospechosas (sólo los lee el admin)
//   lbs/{tabla}            resumen con el top 50 de cada tabla
//   pres/{uid}             en línea (aproximado) · inv/{para_de} invitaciones
// Todo lo demás está cerrado.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // Moderación (pantalla oculta del juego, js/ui/mod-ui.js): sólo esta cuenta.
    function admin() { return signedIn() && me() in ['TMD8t0i6jic7a1sg824ZP55TqOG3']; }
    // Tope de escrituras (20-10-2026): un documento no se puede volver a escribir
    // hasta pasados `secs` segundos desde `last` (su hora guardada). El juego
    // escribe mucho menos que eso; esto sólo frena un bucle (un juego trucado o
    // un fallo), y lo rechazado no se cobra como escritura.
    function every(last, secs) { return !(last is timestamp) || request.time > last + duration.value(secs, 's'); }

    // ---------- partida guardada ----------
    // Sólo su dueño la lee y la escribe. Ya no se marca a nadie solo (14-10-2026:
    // los márgenes contra partidas imposibles dejaban fuera del ranking a gente
    // legal). Lo único que deja a alguien sin ranking es que el admin lo banee
    // (ban = true; el campo viejo "sus" ya no cuenta para nada). El jugador no
    // puede quitarse el baneo: si está, sus guardados tienen que llevarlo.
    match /saves/{uid} {
      allow read: if signedIn() && me() == uid;
      allow read: if admin();
      // (Baneado no: sin documento, validEntry da por hecho que no hay baneo.)
      allow delete: if signedIn() && me() == uid && resource.data.get('ban', false) == false;

      allow create: if signedIn() && me() == uid && validSaveDoc() && saneSave(request.resource.data.save)
        && request.resource.data.get('ban', false) == false
        && request.resource.data.get('rev', 0) is int;
      allow update: if signedIn() && me() == uid && validSaveDoc() && saneSave(request.resource.data.save)
        && request.resource.data.get('ban', false) == resource.data.get('ban', false)
        && every(resource.data.updatedAt, 20) && revOk();
      // El admin sólo puede banear o desbanear (y quitar la marca vieja).
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ban', 'sus'])
        && request.resource.data.get('ban', false) is bool;
    }

    // Versión de la partida (21-10-2026): cada subida trae rev + 1 de la que vio
    // el aparato. Si otro aparato subió entre medias, la nube ya va por delante y
    // se rechaza (el juego lee, junta y vuelve a subir): una copia vieja ya no
    // pisa lo guardado en otro aparato. Mirar resource aquí no cuesta lecturas.
    // Las versiones del juego de antes no mandan rev (se queda igual): pueden
    // seguir guardando sólo mientras ningún aparato nuevo haya subido esa partida.
    function revOk() {
      let had = resource.data.get('rev', 0);
      let now = request.resource.data.get('rev', 0);
      return now is int && (now == had + 1 || (had == 0 && now == 0));
    }

    function validSaveDoc() {
      return request.resource.data.keys().hasOnly(['save', 'updatedAt', 'v', 'sus', 'ban', 'rev'])
        && request.resource.data.save is map
        && request.resource.data.v is int
        && request.resource.data.get('ban', false) is bool
        && request.resource.data.updatedAt == request.time;
    }
    function tk(s, k) { return s.get('tickets', {}).get(k, 0); }
    // Sólo que los números tengan sentido (el juego ya los limpia al cargar).
    function saneSave(s) {
      return s.get('coins', 0) is number && s.get('coins', 0) >= 0
        && tk(s, 't1') is number && tk(s, 't1') >= 0
        && tk(s, 't10') is number && tk(s, 't10') >= 0;
    }

    // ---------- apodos ----------

    match /names/{lower} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        && lower.size() >= 3 && lower.size() <= 16
        && lower == lower.lower();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Perfil público: apodo, 3 favoritos, título, mejores marcas y medallas.
    // Récords del perfil: sólo números (lo que pinta el perfil; nada de texto).
    function validBest(b) {
      return b is map && b.keys().hasOnly(['solo', 'group', 'level', 'bosses', 'legends', 'kills', 'medals'])
        && b.get('solo', 0) is int && b.get('group', 0) is int && b.get('level', 0) is int && b.get('bosses', 0) is int
        && b.get('legends', 0) is int && b.get('kills', 0) is int && b.get('medals', 0) is int;
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'lower', 'at', 'favs', 'title', 'best', 'medals'])
        && request.resource.data.name is string
        && request.resource.data.lower == request.resource.data.name.lower()
        && request.resource.data.at == request.time
        && (!('favs' in request.resource.data) || (request.resource.data.favs is list && request.resource.data.favs.size() <= 3))
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 40))
        && (!('best' in request.resource.data) || validBest(request.resource.data.best))
        && (!('medals' in request.resource.data) || (request.resource.data.medals is list && request.resource.data.medals.size() <= 8))
        && getAfter(/databases/$(database)/documents/names/$(request.resource.data.lower)).data.uid == me()
        && (resource == null || every(resource.data.at, 20));
      allow delete: if signedIn() && me() == uid;
    }

    // ---------- amigos ----------
    // Un documento por pareja, con id "uidMenor_uidMayor".

    match /friendships/{pid} {
      allow read: if signedIn() && (resource == null || me() in resource.data.users);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['users', 'from', 'to', 'status', 'names', 'at'])
        && request.resource.data.from == me()
        && request.resource.data.to != me()
        && request.resource.data.status == 'pending'
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && me() in request.resource.data.users
        && request.resource.data.to in request.resource.data.users
        && pid == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.resource.data.names is map
        && request.resource.data.at == request.time;
      // Sólo quien la recibe puede aceptarla.
      allow update: if signedIn()
        && resource.data.to == me()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'at', 'names'])
        && request.resource.data.status == 'ok';
      allow delete: if signedIn() && me() in resource.data.users;
    }

    // ---------- ranking ----------

    // Hora de inicio de partida: se quitó el 20-10-2026 (era 1/3 de las escrituras
    // y validEntry la leía en cada marca). Sólo se puede borrar lo que quede.
    match /runs/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if false;
    }

    // Una entrada sólo se puede mejorar, nunca empeorar. Anti-trampas:
    //   - no más de 45 min (desde el 18-10-2026 la Sentencia de Arceus deja KO
    //     de un toque hacia el minuto 40; antes era 1 h y se llegaba huyendo)
    //     MrSurvivor: the Lab boards (s_L..., g_L...) take up to 4 h; Lab runs go on past 45:00 (2026-10-24)
    //   - nivel y derrotados con margen de sobra (un grupo de 4 muy bueno)
    //   - la cuenta no puede estar baneada por el admin (saves/{uid}.ban; si aún
    //     no ha guardado nunca en la nube, no tiene documento y no está baneada)
    // Appearance flags are optional for older clients and scores; each teammate gets one boolean.
    function appearanceFlags(v, n) {
      return v is list && v.size() == n && n >= 1 && n <= 4
        && v[0] is bool && (n < 2 || v[1] is bool)
        && (n < 3 || v[2] is bool) && (n < 4 || v[3] is bool);
    }
    function validEntry(board, id) {
      let d = request.resource.data;
      let sv = /databases/$(database)/documents/saves/$(me());
      return d.keys().hasOnly(['t', 'uids', 'names', 'dex', 'shiny', 'mega', 'radiant', 'lv', 'kills', 'at'])
        && d.t is int && d.t > 0 && d.t <= 14400
        && d.lv is int && d.lv >= 1 && d.lv <= 10 + d.t / 4
        && d.kills is int && d.kills >= 0 && d.kills <= 100 + d.t * 12
        && (!exists(sv) || get(sv).data.get('ban', false) == false)
        && d.uids is list && me() in d.uids
        && d.names is list && d.names.size() == d.uids.size()
        && d.dex is list && d.dex.size() == d.uids.size()
        && d.shiny is list && d.shiny.size() == d.uids.size()
        && (!('mega' in d) || appearanceFlags(d.mega, d.uids.size()))
        && (!('radiant' in d) || appearanceFlags(d.radiant, d.uids.size()))
        && d.at == request.time
        && (board.matches('s_.*')
              ? (d.uids.size() == 1 && id == me())
              : (d.uids.size() >= 2 && d.uids.size() <= 4 && id == d.uids.join('_')))
        && (resource == null || d.t > resource.data.t);
    }

    match /lb/{board}/e/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validEntry(board, id);
      allow delete: if signedIn() && (me() in resource.data.uids || admin());
    }

    // Resumen con el top 50 de cada tabla (lo que se lee al mirar el ranking).
    //   top: { id: { t, uids, names, dex, shiny, lv, kills } }
    //   me:  la fila que añades o mejoras (debe coincidir con tu marca validada,
    //        escrita en la misma transacción)
    //   ev:  la fila que sale del top (sólo si tiene menos tiempo que la tuya)
    // Al borrar la cuenta: me = '' y ev = una fila tuya que se quita.
    function validTop(board) {
      let d = request.resource.data;
      let old = resource == null ? {} : resource.data.top;
      let changed = d.top.diff(old).affectedKeys();
      return d.keys().hasOnly(['top', 'me', 'ev'])
        && d.top is map && d.top.size() <= 50
        && d.me is string && d.ev is string
        && (d.me == '' ? (removeMine(d, old, changed) || adminRemove(d, old)) : addMine(board, d, old, changed));
    }
    // Moderación: el admin sólo puede QUITAR filas del top.
    function adminRemove(d, old) {
      return admin() && old.keys().hasAll(d.top.keys()) && d.top.diff(old).changedKeys().size() == 0;
    }
    function addMine(board, d, old, changed) {
      let e = getAfter(/databases/$(database)/documents/lb/$(board)/e/$(d.me)).data;
      let row = d.top[d.me];
      // La fila del resumen es una COPIA exacta de la marca ya validada (validEntry):
      // también nivel, derrotados y shiny (18-10-2026: sin esto se podía meter
      // texto con código en el "nivel" y se ejecutaba en quien abría el ranking).
      // shiny es opcional: las versiones del juego de antes del 18-10 no lo ponían.
      return me() in e.uids
        && changed.hasOnly([d.me, d.ev])
        && row.keys().hasOnly(['t', 'uids', 'names', 'dex', 'shiny', 'mega', 'radiant', 'lv', 'kills'])
        && row.t == e.t && row.uids == e.uids && row.names == e.names && row.dex == e.dex
        && row.lv == e.lv && row.kills == e.kills
        && (!('shiny' in row) || row.shiny == e.shiny)
        && row.get('mega', []) == e.get('mega', [])
        && row.get('radiant', []) == e.get('radiant', [])
        && (d.ev == '' || (!(d.ev in d.top) && d.ev in old && old[d.ev].t <= e.t));
    }
    function removeMine(d, old, changed) {
      return d.ev in old && me() in old[d.ev].uids && !(d.ev in d.top) && changed.hasOnly([d.ev]);
    }

    match /lbs/{board} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validTop(board);
    }

    // Presencia aproximada: "en línea" si at es de hace menos de unos minutos.
    match /pres/{uid} {
      allow read: if signedIn();
      // Quitado el 20-10-2026 (era 1/4 de las escrituras): nadie puede escribirlo,
      // así tampoco gastan las versiones viejas del juego. Sólo se puede borrar.
      allow create, update: if false;
      allow delete: if signedIn() && me() == uid;
    }

    // Invitaciones a una sala: id "para_de". Sólo entre amigos confirmados.
    match /inv/{id} {
      allow read: if signedIn() && (resource == null || me() == resource.data.to || me() == resource.data.from);
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['to', 'from', 'room', 'name', 'at'])
        && request.resource.data.from == me()
        && id == request.resource.data.to + '_' + me()
        && request.resource.data.room is string && request.resource.data.room.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && request.resource.data.at == request.time
        && get(/databases/$(database)/documents/friendships/$(request.resource.data.to < me() ? request.resource.data.to + '_' + me() : me() + '_' + request.resource.data.to)).data.status == 'ok';
      allow delete: if signedIn() && (me() == resource.data.to || me() == resource.data.from);
    }

    // ---------- reportes ----------
    // Un reporte por jugador y marca (id "tabla__marca__tuUid"). Los lee y
    // borra el admin desde la pantalla oculta de moderación.
    match /reports/{rid} {
      allow read, delete: if admin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['board', 'e', 'names', 't', 'by', 'at'])
        && request.resource.data.by == me()
        && request.resource.data.board is string && request.resource.data.board.size() <= 40
        && request.resource.data.e is string && request.resource.data.e.size() <= 160
        && request.resource.data.names is list && request.resource.data.names.size() <= 4
        && request.resource.data.t is int
        && request.resource.data.at == request.time
        && rid == request.resource.data.board + '__' + request.resource.data.e + '__' + me();
    }

    // Para borrar todas tus marcas al borrar la cuenta (consulta de grupo).
    match /{path=**}/e/{id} {
      allow read: if signedIn();
    }

    // ---------- Fork (MrSurvivor): Player Manager (js/fork/player-manager.js) ----------
    // The admin edits a player's cloud save. Every edit is one the game's merge keeps
    // (js/fork/player-edits.js): coins on their own ledger line, deletions as tombstones,
    // resets as epochs. The ban stays as it is (the moderation rule above changes it).
    match /saves/{uid} {
      allow update: if admin() && validSaveDoc() && saneSave(request.resource.data.save)
        && request.resource.data.get('ban', false) == resource.data.get('ban', false);
    }
    // Clearing a reset player's public profile (favourites, title, records, medals).
    match /profiles/{uid} {
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favs', 'title', 'best', 'medals', 'at'])
        && request.resource.data.at == request.time;
    }
    // adm/live: { watch: until when (ms) players report their status, pokes: { uid: ms } (re-read
    // your save), cmd: { uid: { k, at } } }. Everyone listens to it; only the admin writes.
    match /adm/{doc} {
      allow read: if signedIn();
      allow write: if admin();
    }
    // Live status, written only while the admin watches (js/fork/presence.js).
    match /apres/{uid} {
      allow read: if admin();
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['at', 'n', 'st'])
        && request.resource.data.at == request.time
        && request.resource.data.n is string && request.resource.data.n.size() <= 24
        && request.resource.data.st is map && request.resource.data.st.size() <= 24
        && (resource == null || every(resource.data.at, 3));
      allow delete: if signedIn() && (me() == uid || admin());
    }

    // ---------- Fork (MrSurvivor): Requests, the artist's line to Claude (js/fork/requests.js) ----------
    // req/{id}: a request or question from a staff account (the admin and the artist; the watcher,
    // fork/requests.cjs, writes as a service account and skips these rules). Staff read every thread,
    // create their own, post messages as themselves, may set an 'ask' back to 'new' (they answered) and
    // close their own open request. Status otherwise is the admin's (and the watcher's). Pictures are
    // data URLs, up to 3 of 300 KB, so a thread stays inside one document.
    // The owner; Mello (the artist). js/fork/requests.js STAFF lists the same uids.
    function staff() { return signedIn() && me() in ['TMD8t0i6jic7a1sg824ZP55TqOG3', 'WjnOOXwYUhcbpvMYj2XUN3dUE5P2']; }
    function rqText(t) { return t is string && t.size() <= 4000; }
    function rqPics(d) {
      return !('pics' in d) || (d.pics is list && d.pics.size() <= 3
        && (d.pics.size() < 1 || (d.pics[0] is string && d.pics[0].size() <= 300000))
        && (d.pics.size() < 2 || (d.pics[1] is string && d.pics[1].size() <= 300000))
        && (d.pics.size() < 3 || (d.pics[2] is string && d.pics[2].size() <= 300000)));
    }
    match /req/{id} {
      allow read: if staff();
      allow create: if staff()
        && request.resource.data.keys().hasOnly(['by', 'n', 'k', 't', 'pics', 'st', 'at', 'up', 'lb'])
        && request.resource.data.by == me() && request.resource.data.lb == me()
        && request.resource.data.n is string && request.resource.data.n.size() <= 24
        && request.resource.data.k in ['q', 'c']
        && rqText(request.resource.data.t) && request.resource.data.t.size() > 0
        && request.resource.data.st == 'new'
        && request.resource.data.at == request.time && request.resource.data.up == request.time
        && rqPics(request.resource.data);
      allow update: if admin() || (staff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'up', 'lb'])
        && request.resource.data.up == request.time && request.resource.data.lb == me()
        && (request.resource.data.st == resource.data.st
          || (resource.data.st == 'ask' && request.resource.data.st == 'new')
          || (resource.data.by == me() && resource.data.st in ['new', 'ask'] && request.resource.data.st == 'closed')));
      allow delete: if admin();
      match /m/{mid} {
        allow read: if staff();
        allow create: if staff()
          && request.resource.data.keys().hasOnly(['by', 'n', 't', 'at', 'pics'])
          && request.resource.data.by == me()
          && request.resource.data.n is string && request.resource.data.n.size() <= 24
          && rqText(request.resource.data.t)
          && (request.resource.data.t.size() > 0 || ('pics' in request.resource.data && request.resource.data.pics.size() > 0))
          && request.resource.data.at == request.time
          && rqPics(request.resource.data);
        allow update, delete: if admin();
      }
    }

    // ---------- Fork (MrSurvivor): trading Pokémon between friends (js/fork/trade.js) ----------
    // Each save is written only by its owner, so these rules are what makes a trade fair: only your
    // own offer and confirmation are yours to write; a confirmation names the offer version (rv) it
    // saw and counts only for that one (any change unconfirms both); 'done' needs both confirmations
    // of the current offers, 3-60 s after the later one, both players heard from in the last minute,
    // and both players' locks (tl) on this trade. Each game then applies it to its own save and takes
    // itself off `pend` in the same write as that save (which must record the trade).
    function tLock(u) { return /databases/$(database)/documents/tl/$(u); }
    function tDoc(id) { return /databases/$(database)/documents/trades/$(id); }
    function tFriends(x, y) {
      return get(/databases/$(database)/documents/friendships/$(x < y ? x + '_' + y : y + '_' + x)).data.status == 'ok';
    }
    function tIn() { return resource.data.a == me() || resource.data.b == me(); }
    function tSide() { return me() == resource.data.a ? 'a' : 'b'; }
    function tOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    match /trades/{id} {
      allow read: if signedIn() && tIn();
      allow create: if signedIn() && tNew(id);
      allow update: if signedIn() && tIn() && request.resource.data.at == request.time
        && (tJoin(id) || tLeave() || tBeat() || tOffer() || tConfirm() || tUnconfirm() || tDone(id) || tApplied(id));
    }
    function tNew(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['a', 'b', 'users', 'na', 'st', 'oa', 'ob', 'rv', 'ka', 'kb', 'ta', 'tb', 'ha', 'hb', 'pend', 'at'])
        && d.a == me() && d.b is string && d.b != me() && d.users == [d.a, d.b]
        && d.na == get(/databases/$(database)/documents/profiles/$(me())).data.name
        && d.st == 'ask' && d.oa == [] && d.ob == [] && d.rv == 0 && d.ka == 0 && d.kb == 0
        && d.ta == null && d.tb == null && d.ha == request.time && d.hb == null && d.pend == [] && d.at == request.time
        && tFriends(d.a, d.b)
        && getAfter(tLock(me())).data.t == id;
    }
    // The friend who was asked comes in (within 10 min) with their lock on it.
    function tJoin(id) {
      return resource.data.st == 'ask' && me() == resource.data.b
        && tOnly(['st', 'hb', 'at']) && request.resource.data.st == 'open' && request.resource.data.hb == request.time
        && request.time < resource.data.at + duration.value(10, 'm')
        && getAfter(tLock(me())).data.t == id;
    }
    function tLeave() {
      return resource.data.st in ['ask', 'open'] && tOnly(['st', 'by', 'at'])
        && request.resource.data.st == 'off' && request.resource.data.by == me();
    }
    function tBeat() {
      return resource.data.st == 'open' && tOnly(['h' + tSide(), 'at']) && request.resource.data['h' + tSide()] == request.time;
    }
    function tOffer() {
      let o = request.resource.data['o' + tSide()];
      return resource.data.st == 'open' && tOnly(['o' + tSide(), 'rv', 'at'])
        && o is list && o.size() <= 20 && request.resource.data.rv == resource.data.rv + 1;
    }
    function tConfirm() {
      let d = request.resource.data;
      return resource.data.st == 'open' && tOnly(['k' + tSide(), 't' + tSide(), 'at'])
        && resource.data.rv > 0 && resource.data.oa.size() + resource.data.ob.size() > 0
        && d['k' + tSide()] == resource.data.rv && d['t' + tSide()] == request.time;
    }
    function tUnconfirm() {
      let d = request.resource.data;
      return resource.data.st == 'open' && tOnly(['k' + tSide(), 't' + tSide(), 'at'])
        && d['k' + tSide()] == 0 && d['t' + tSide()] == null;
    }
    function tDone(id) {
      let t = resource.data;
      let d = request.resource.data;
      return t.st == 'open' && tOnly(['st', 'pend', 'done', 'at'])
        && d.st == 'done' && d.pend == t.users && d.done == request.time
        && t.rv > 0 && t.ka == t.rv && t.kb == t.rv && t.oa.size() + t.ob.size() > 0
        && tCounted(t.ta > t.tb ? t.ta : t.tb)
        && request.time < t.ha + duration.value(60, 's') && request.time < t.hb + duration.value(60, 's')
        && get(tLock(t.a)).data.t == id && get(tLock(t.b)).data.t == id;
    }
    function tCounted(last) {
      return request.time > last + duration.value(3, 's') && request.time < last + duration.value(60, 's');
    }
    function tApplied(id) {
      return resource.data.st == 'done' && me() in resource.data.pend && tOnly(['pend', 'at'])
        && request.resource.data.pend == resource.data.pend.removeAll([me()])
        && getAfter(/databases/$(database)/documents/saves/$(me())).data.save.get('trd', {}).get(id, null) != null;
    }
    // What each player has (for the other's "has it" marks) and the chat.
    match /trades/{id}/h/{u} {
      allow read: if signedIn() && me() in get(tDoc(id)).data.users;
      allow create, update: if signedIn() && me() == u && me() in get(tDoc(id)).data.users
        && request.resource.data.keys().hasOnly(['o', 's', 'r'])
        && request.resource.data.o is list && request.resource.data.o.size() <= 3000
        && request.resource.data.s is list && request.resource.data.s.size() <= 3000
        && request.resource.data.r is list && request.resource.data.r.size() <= 3000;
    }
    match /trades/{id}/m/{mid} {
      allow read: if signedIn() && me() in get(tDoc(id)).data.users;
      allow create: if signedIn() && me() in get(tDoc(id)).data.users && get(tDoc(id)).data.st == 'open'
        && request.resource.data.keys().hasOnly(['u', 't', 'at'])
        && request.resource.data.u == me()
        && request.resource.data.t is string && request.resource.data.t.size() > 0 && request.resource.data.t.size() <= 200
        && request.resource.data.at == request.time;
    }
    // tl/{uid}: the one trade a player is in. It can't leave a finished trade its player hasn't applied.
    match /tl/{u} {
      allow read: if signedIn() && me() == u;
      allow create, update: if signedIn() && me() == u
        && request.resource.data.keys().hasOnly(['t', 'at'])
        && request.resource.data.t is string && request.resource.data.at == request.time
        && me() in getAfter(tDoc(request.resource.data.t)).data.users
        && (resource == null || resource.data.t == request.resource.data.t || !exists(tDoc(resource.data.t))
            || !(me() in getAfter(tDoc(resource.data.t)).data.get('pend', [])));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
